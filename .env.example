HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
NODE_ENV=development
OWNER_EMAIL=owner@example.test
OWNER_NAME=Business owner
DATA_DIR=./runtime
# Local development only: codes appear in runtime/mailbox, never in the API.
MAIL_MODE=local
# For real email set MAIL_MODE=resend and supply your provider configuration.
RESEND_API_KEY=
MAIL_FROM=
# Production requires HTTPS origin, secure cookies and a configured real sender.
UPLOAD_MAX_BYTES=5242880
